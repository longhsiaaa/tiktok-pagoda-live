# Cấu hình kênh TikTok Livestream (Để trống nếu chỉ dùng Web / Local Mode)
TIKTOK_USERNAME=

# Cổng khởi chạy Web Server (Mặc định 3001)
PORT=3001

# Chế độ chạy thử tự động sinh tương tác (true / false)
SIMULATE=false

# Tên Chùa hiển thị trên Chánh Điện
TEMPLE_NAME=VẠN PHÚC TỰ

# Tự động đọc Sớ Cầu An định kỳ (phút, ví dụ 15 phút một lần, đặt 0 để tắt)
SO_INTERVAL_MINUTES=15
